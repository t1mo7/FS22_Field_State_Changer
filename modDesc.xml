<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<modDesc descVersion="72">
    <author>Timo</author>
    <version>1.0.2.0</version>
    <title>
        <en>Field State Changer</en>
    </title>
    <description>
        <en><![CDATA[Instantly change the state of a field: plowed, cultivated, stubble tilled, rolled, mulched, limed, fertilized or weeds removed.

Usage: walk onto one of your fields and press ALT + F, then pick a state.

Console (developer console): fscSetField <fieldNumber|here> <state>
Type fscStates for a list of states.]]></en>
    </description>
    <iconFilename>icon_fieldStateChanger.dds</iconFilename>
    <multiplayer supported="true"/>

    <extraSourceFiles>
        <sourceFile filename="scripts/FieldStateChanger.lua"/>
    </extraSourceFiles>

    <actions>
        <action name="FSC_MENU" category="ONFOOT"/>
    </actions>

    <inputBinding>
        <actionBinding action="FSC_MENU">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lalt KEY_f"/>
        </actionBinding>
    </inputBinding>

    <l10n>
        <text name="input_FSC_MENU">
            <en>Change field state</en>
        </text>
    </l10n>
</modDesc>
